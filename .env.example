# ─── rclone RC daemon ────────────────────────────────────────────────────────
# URL of the rclone RC daemon. Default: http://127.0.0.1:5572
# Change this only if you run rclone on a different port or host.
RC_URL=http://127.0.0.1:5572

# ─── Network ─────────────────────────────────────────────────────────────────
# IP address to bind to. Use 0.0.0.0 for all interfaces, or your Tailscale IP.
BIND=0.0.0.0
# Port for the web UI.
PORT=8768

# ─── Storage ─────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
DB_PATH=./syncdeck.db

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of local directories the app is allowed to browse.
# The app will refuse to access any path outside these roots.
# Example: /mnt,/home/user/Downloads
ALLOWED_ROOTS=/mnt
