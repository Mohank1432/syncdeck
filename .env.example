# ─── Docker Host Binding ─────────────────────────────────────────────────────
# IP to bind on the host. Default is 127.0.0.1 (local only).
# Set to your Tailscale IP (e.g. 100.108.93.22) to expose safely across your private mesh.
HOST_BIND=127.0.0.1
HOST_PORT=8780

# ─── rclone RC daemon ────────────────────────────────────────────────────────
# In Docker Compose, the daemon container is reached at http://syncdeck-rcd:5572.
# For bare-metal / systemd installations, use http://127.0.0.1:5572.
RC_URL=http://127.0.0.1:5572

# ─── Local Media & Storage Paths ─────────────────────────────────────────────
# Root directory on host mounted into the containers for file transfers.
MEDIA_ROOT=/mnt

# Comma-separated list of local directories the app is allowed to browse.
# The app will refuse to access any path outside these roots.
ALLOWED_ROOTS=/mnt

# ─── App Settings ────────────────────────────────────────────────────────────
BIND=0.0.0.0
PORT=8768
DB_PATH=./syncdeck.db
